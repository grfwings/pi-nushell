{
  "name": "pi-nushell",
  "version": "0.1.0",
  "description": "A Pi extension that adds a Nushell command-execution tool.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "nushell"
  ],
  "license": "Unlicense",
  "packageManager": "bun@1.3.13",
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
