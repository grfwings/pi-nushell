{
  "name": "pi-nushell",
  "version": "0.1.1",
  "description": "A Pi extension that adds a Nushell command-execution tool.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "nushell"
  ],
  "author": "Griffin Evans <griffinevans@protonmail.com>",
  "license": "Unlicense",
  "homepage": "https://github.com/grfwings/pi-nushell#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grfwings/pi-nushell.git"
  },
  "bugs": {
    "url": "https://github.com/grfwings/pi-nushell/issues"
  },
  "packageManager": "bun@1.3.13",
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run check && bun run test"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/bun": "1.3.13",
    "@types/node": "^26.4.1",
    "typebox": "^1.3.25",
    "typescript": "^7.0.2"
  }
}
